{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "backend/index.js"
    },
    {
      "src": "/v1(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/auth(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/admin(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/api(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "frontend/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}