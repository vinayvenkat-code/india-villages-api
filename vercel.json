{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "backend/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "backend/index.js"
    },
    {
      "source": "/v1/:path*",
      "destination": "backend/index.js"
    },
    {
      "source": "/auth/:path*",
      "destination": "backend/index.js"
    },
    {
      "source": "/admin/:path*",
      "destination": "backend/index.js"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}